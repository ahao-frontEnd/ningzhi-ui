{
    "compilerOptions": {
        "target": "ES2015",
        "lib": ["DOM", "ESNext"],
        "allowJs": true,
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "jsx": "react-jsx",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "experimentalDecorators": true,
        "moduleResolution": "node",
        "paths": {
            "@ningzhi/*": ["./packages/@ningzhi/*/src"]
        }
    },
    "$schema": "https://json.schemastore.org/tsconfig",
    "display": "Base",
    "include": ["packages/**/*"],
    "exclude": ["packages/**/es/*"] // tsup 的构建产物
}
